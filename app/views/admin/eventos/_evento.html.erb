<div id="<%= dom_id evento %>">
  <p>
    <strong>Nome:</strong>
    <%= evento.nome %>
  </p>

  <p>
    <strong>Descricao:</strong>
    <%= evento.descricao %>
  </p>

  <p>
    <strong>Local:</strong>
    <%= evento.local %>
  </p>

  <p>
    <strong>Data:</strong>
    <%= evento.data %>
  </p>

  <p>
    <strong>Link ingresso:</strong>
    <%= evento.link_ingresso %>
  </p>

  <p>
    <strong>Image:</strong>
    <%= evento.image %>
  </p>

</div>
