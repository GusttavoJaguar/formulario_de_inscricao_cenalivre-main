<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>
<div align="center">
  <h1>Posts</h1>
<br><br>
  <div id="posts">
    <% @posts.each do |post| %>
      <%= render post %>
      <p>
        <%= link_to "Show this post", admin_post_path(post) %>
      </p>
    <% end %>
  </div>

  <%= link_to "New post", new_admin_post_path %>
</div>
