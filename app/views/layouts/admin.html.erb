<!DOCTYPE html>
<html>
<head>
    <title><%= content_for(:title) || "Blog Cena Livre" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>


    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'rails-ujs' %>

    
    <%= stylesheet_link_tag 'https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css' %>
    <%= stylesheet_link_tag 'application', media: 'all', "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  </head>
<body>
 
<nav class="navbar fixed-top navbar-expand-lg navbar-dark py-3 text-white" style="border-bottom: 2px solid #ff5733;"> 
      <div class="container-fluid">
       
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarScroll">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 navbar-nav" style="--bs-scroll-height: 100px;">
           
    <li class="nav-item">
      <a class="nav-link" href="<%= root_path %>">Início</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="<%= sobre_path %>">Sobre</a>
    </li>
    
    <li class="nav-item">
      <a class="nav-link" href="<%= posts_path %>">Postagens</a>
    </li>
      <li class="nav-item">
        <a class="nav-link" href="<%= eventos_path %>">Eventos</a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link" href="<%= inscricaos_path %>">Inscrições</a>
      </li>
      <li class="nav-item">
      <a class="nav-link" href="<%= contatos_path %>">Contatos</a>
    </li>
    </ul>
  </div>
</nav>
<br><br>

<div class="container mt-4">
    
    <br><br>
  <%= yield %>


  
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.7/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <br><br><br>

  <footer class="bg-dark text-white text-center py-3">
  <p>&copy; 2025 Cena Livre. Todos os direitos reservados.</p>
</footer>

  </body>
</html>
