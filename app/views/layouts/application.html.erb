<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog Cena Livre" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>

    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'rails-ujs' %>

    
    <%= stylesheet_link_tag 'https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css' %>
    <%= stylesheet_link_tag 'application', media: 'all', "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  </head>

  <body>


  <nav class="navbar fixed-top navbar-expand-lg navbar-dark py-3 text-white" style="border-bottom: 2px solid #ff5733;"> 
      <div class="container-fluid">
       
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarScroll">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 navbar-nav" style="--bs-scroll-height: 100px;">
           
    <li class="nav-item">
      <a class="nav-link" href="<%= root_path %>">Início</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="<%= sobre_path %>">Sobre</a>
    </li>
    
    <li class="nav-item">
      <a class="nav-link" href="<%= posts_path %>">Postagens</a>
    </li>
      <li class="nav-item">
        <a class="nav-link" href="<%= eventos_path %>">Eventos</a>
      </li>
      
      <li class="nav-item">
        <a class="nav-link" href="<%= inscricaos_path %>">Inscrições</a>
      </li>
      <li class="nav-item">
      <a class="nav-link" href="<%= contatos_path %>">Contatos</a>
    </li>
    </ul>
  </div>
</nav>
<br><br>

<div class="container mt-4" align="center">
    
    <br><br>
  <%= yield %>

</div>
  
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.7/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <br><br><br>

  <div class="footer-container p-4">
        <div class="footer-about">
          <div class="footer-logo">
            <i data-feather="activity"></i>
            <span>Cena Livre</span>
          </div>
          <p>A plataforma da cultura urbana: hiphop, grafite, breaking e muito mais!</p>
          <div class="social-links">
            <a href="#"><i data-feather="instagram"></i></a>
            <a href="#"><i data-feather="facebook"></i></a>
            <a href="#"><i data-feather="twitter"></i></a>
            <a href="#"><i data-feather="youtube"></i></a>
          </div>
        </div>
       
        <div class="footer-links">
          <h3>Contato</h3>
          <ul>
            <li><i data-feather="mail"></i> contato@cenalivre.com</li>
            <li><i data-feather="phone"></i> (11) 9999-9999</li>
            <li><i data-feather="map-pin"></i> São Paulo, SP</li>
          </ul>
        </div>
      </div>
      <div class="copyright">
        &copy; ${new Date().getFullYear()} Cena Livre Eventos. Todos os direitos reservados.
      </div>>

  </body>
</html>
