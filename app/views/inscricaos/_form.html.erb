<!DOCTYPE html>
<html>
<%= form_with(model: @inscricao) do |form| %>
  <% if @inscricao.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@inscricao.errors.count, "error") %> prohibited this inscricao from being saved:</h2>

      <ul>
        <% @inscricao.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :nome, style: "display: block" %>
    <%= form.text_field :nome %>
  </div>

  <div>
    <%= form.label :alcunha, style: "display: block" %>
    <%= form.text_field :alcunha %>
  </div>

  <div>
    <%= form.label :regiao, style: "display: block" %>
    <%= form.text_field :regiao %>
  </div>

  <div>
    <%= form.label :contato, style: "display: block" %>
    <%= form.text_field :contato %>
  </div>

  <div>
    <%= form.label :data_nascimento, style: "display: block" %>
    <%= form.date_field :data_nascimento %>
  </div>
 
  <br>
  
  <div>
    <%= form.submit "Salvar", class: "btn btn-success" %>
  </div>
<% end %>
</html>